# Supply locally; never commit real credentials.
DATABASE_URL=jdbc:postgresql://localhost:5432/airsense
DATABASE_USER=airsense
DATABASE_PASSWORD=
MQTT_URI=ssl://your-broker-host:8883
MQTT_USERNAME=airsense
MQTT_PASSWORD=
MQTT_ENABLED=true
APP_ORIGIN=http://127.0.0.1:5173
SECURE_COOKIE=false
PORT=8080

# Optional integration tests: use a separate disposable database.
# TEST_DATABASE_URL=jdbc:postgresql://localhost:5432/airsense_test
# TEST_DATABASE_USER=airsense
# TEST_DATABASE_PASSWORD=
# RUN_MQTT_TESTS=true
# RUN_MQTT_TESTS uses disposable Docker services, not MQTT_URI above.
