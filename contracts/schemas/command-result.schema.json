{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airsense.example/contracts/v1/command-result.schema.json",
  "title": "AirSense v1 command-result",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "deviceId": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9_-]{0,63}$"
    },
    "commandId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "status": {
      "enum": [
        "APPLIED",
        "REJECTED"
      ]
    },
    "reportIntervalSec": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "code": {
      "enum": [
        "APPLIED",
        "EXPIRED",
        "INVALID_COMMAND",
        "UNSUPPORTED_COMMAND"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "deviceId",
    "commandId",
    "status",
    "reportIntervalSec",
    "code"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "APPLIED"
          }
        }
      },
      "then": {
        "properties": {
          "code": {
            "const": "APPLIED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "REJECTED"
          }
        }
      },
      "then": {
        "properties": {
          "code": {
            "not": {
              "const": "APPLIED"
            }
          }
        }
      }
    }
  ]
}
