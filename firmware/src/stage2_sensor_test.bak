
/*
 * AirSense - Stage 2
 * ESP32-S3 + DHT22 + MQ135 + SCD40 (All-in-One Comparison)
 */

#include <Arduino.h>
#include <Wire.h>
#include <DHT.h>

#define DEVICE_ID   "AIRSENSE-001"
#define DHT_PIN     4
#define DHT_TYPE    DHT22
#define MQ135_PIN   5   // Analog output (AO) của MQ135 nối vào GPIO 5 (ADC1)

// Thông số chuẩn của cảm biến MQ135 để ước lượng CO2 (ppm)
#define MQ135_RLOAD 10.0f           // Điện trở tải trên module (kOhm)
#define MQ135_RZERO 64.80f          // Điện trở chuẩn R0 đã hiệu chuẩn theo cảm biến chuẩn SCD40
#define MQ135_PARA  116.6020682f    // Hệ số A đường đặc tuyến CO2
#define MQ135_PARB  2.769034857f    // Hệ số B đường đặc tuyến CO2

// Chân I2C cho cảm biến SCD40 trên ESP32-S3
#define I2C_SDA_PIN 8
#define I2C_SCL_PIN 9
#define SCD40_ADDR  0x62

DHT dht(DHT_PIN, DHT_TYPE);
bool scd40Connected = false;

// In ra đồng thời cả cổng USB (Serial / HWCDC) và cổng UART (Serial0 / CH343)
void logPrintf(const char *format, ...) {
  char buf[256];
  va_list args;
  va_start(args, format);
  vsnprintf(buf, sizeof(buf), format, args);
  va_end(args);

  Serial.print(buf);
  Serial0.print(buf);
}

// ==================== HÀM XỬ LÝ MQ135 ====================

// Tính hệ số bù nhiệt độ và độ ẩm cho MQ135
float getCorrectionFactor(float temperature, float humidity) {
  return 0.00035f * temperature * temperature - 0.02718f * temperature + 1.39538f - (humidity - 33.0f) * 0.0018f;
}

// Chuyển đổi giá trị ADC (12-bit: 0..4095) của MQ135 sang nồng độ CO2 ước lượng (ppm)
float calculateMQ135CO2PPM(int adcRaw, float temperature, float humidity) {
  if (adcRaw <= 0 || adcRaw >= 4095) {
    return 0.0f;
  }
  // Tính điện trở cảm biến Rs (kOhm)
  float rs = ((4095.0f / (float)adcRaw) - 1.0f) * MQ135_RLOAD;

  // Bù nhiệt độ & độ ẩm nếu có dữ liệu hợp lệ
  if (!isnan(temperature) && !isnan(humidity)) {
    rs /= getCorrectionFactor(temperature, humidity);
  }

  // Công thức đặc tuyến: PPM = PARA * (Rs / R0)^(-PARB)
  return MQ135_PARA * powf((rs / MQ135_RZERO), -MQ135_PARB);
}

// ==================== HÀM XỬ LÝ SCD40 (I2C) ====================

// Tính CRC-8 theo chuẩn Sensirion SCD4x (Polynomial: 0x31, Init: 0xFF)
uint8_t scd40CalcCRC(uint8_t data0, uint8_t data1) {
  uint8_t crc = 0xFF;
  uint8_t buf[2] = {data0, data1};
  for (int i = 0; i < 2; i++) {
    crc ^= buf[i];
    for (uint8_t bit = 8; bit > 0; --bit) {
      if (crc & 0x80) {
        crc = (crc << 1) ^ 0x31;
      } else {
        crc = (crc << 1);
      }
    }
  }
  return crc;
}

// Gửi lệnh 16-bit tới SCD40 qua I2C
bool scd40SendCommand(uint16_t cmd) {
  Wire.beginTransmission(SCD40_ADDR);
  Wire.write((uint8_t)(cmd >> 8));
  Wire.write((uint8_t)(cmd & 0xFF));
  return (Wire.endTransmission() == 0);
}

// Khởi tạo cảm biến SCD40
bool scd40Init() {
  // Dừng đo định kỳ trước đó (nếu cảm biến đang chạy)
  if (!scd40SendCommand(0x3F86)) {
    return false;
  }
  delay(500);

  // Bắt đầu chế độ đo định kỳ (Periodic Measurement - 5 giây/lần)
  if (!scd40SendCommand(0x21B1)) {
    return false;
  }
  return true;
}

// Kiểm tra xem SCD40 đã có dữ liệu mới chưa (lệnh 0xE4B8)
bool scd40IsDataReady() {
  if (!scd40SendCommand(0xE4B8)) {
    return false;
  }
  delay(1);
  if (Wire.requestFrom(SCD40_ADDR, (uint8_t)3) != 3) {
    return false;
  }
  uint8_t msb = Wire.read();
  uint8_t lsb = Wire.read();
  uint8_t crc = Wire.read();
  if (scd40CalcCRC(msb, lsb) != crc) {
    return false;
  }
  uint16_t status = ((uint16_t)msb << 8) | lsb;
  return ((status & 0x07FF) != 0);
}

// Đọc nồng độ CO2 (ppm), nhiệt độ (°C) và độ ẩm (%) từ SCD40 (lệnh 0xEC05)
bool scd40ReadMeasurement(uint16_t &co2, float &temp, float &hum) {
  if (!scd40SendCommand(0xEC05)) {
    return false;
  }
  delay(1);
  if (Wire.requestFrom(SCD40_ADDR, (uint8_t)9) != 9) {
    return false;
  }

  uint8_t buf[9];
  for (int i = 0; i < 9; i++) {
    buf[i] = Wire.read();
  }

  // Kiểm tra CRC cho cả 3 cụm dữ liệu
  if (scd40CalcCRC(buf[0], buf[1]) != buf[2] ||
      scd40CalcCRC(buf[3], buf[4]) != buf[5] ||
      scd40CalcCRC(buf[6], buf[7]) != buf[8]) {
    return false;
  }

  co2 = ((uint16_t)buf[0] << 8) | buf[1];
  uint16_t rawTemp = ((uint16_t)buf[3] << 8) | buf[4];
  uint16_t rawHum  = ((uint16_t)buf[6] << 8) | buf[7];

  temp = -45.0f + 175.0f * ((float)rawTemp / 65535.0f);
  hum  = 100.0f * ((float)rawHum / 65535.0f);
  return true;
}

// ==================== SETUP & LOOP ====================

void setup() {
  Serial.begin(115200);
  Serial0.begin(115200);
  delay(1500);

  // Khởi tạo DHT22
  dht.begin();

  // Khởi tạo MQ135
  pinMode(MQ135_PIN, INPUT);
  analogReadResolution(12); // ADC 12-bit (0 - 4095)

  // Khởi tạo I2C cho SCD40
  Wire.begin(I2C_SDA_PIN, I2C_SCL_PIN);

  logPrintf("\n==========================================\n");
  logPrintf("            AirSense ESP32-S3\n");
  logPrintf("   DHT22 + MQ135 + SCD40 Initialized\n");
  logPrintf("==========================================\n");
  logPrintf("Device ID: %s\n", DEVICE_ID);
  logPrintf("Pins: DHT22=GPIO%d | MQ135=GPIO%d | SCD40(SDA=%d, SCL=%d)\n",
            DHT_PIN, MQ135_PIN, I2C_SDA_PIN, I2C_SCL_PIN);

  scd40Connected = scd40Init();
  if (scd40Connected) {
    logPrintf("[OK] Tim thay cam bien SCD40 (0x62)! Dang cho chu ky do dau tien (5s)...\n");
  } else {
    logPrintf("[WARN] Khong tim thay SCD40 tai dia chi 0x62! Kiem tra day VCC(3V3), GND, SDA(8), SCL(9)\n");
  }
}

void loop() {
  // Chu kỳ đọc 5 giây (đồng bộ với chu kỳ lấy mẫu 5s của SCD40)
  delay(5000);

  float dhtTemp = dht.readTemperature();
  float dhtHum  = dht.readHumidity();

  logPrintf("------------------------------------------\n");

  // 1. Đọc & hiển thị DHT22
  if (isnan(dhtTemp) || isnan(dhtHum)) {
    logPrintf("[DHT22] Khong doc duoc du lieu (kiem tra GPIO %d)\n", DHT_PIN);
  } else {
    logPrintf("[DHT22] Temp: %.1f C | Humidity: %.1f %%\n", dhtTemp, dhtHum);
  }

  // 2. Đọc & hiển thị SCD40 (CO2 thật + Temp + Humidity)
  float refTemp = dhtTemp;
  float refHum  = dhtHum;

  if (!scd40Connected) {
    scd40Connected = scd40Init();
  }

  if (scd40Connected) {
    if (scd40IsDataReady()) {
      uint16_t scdCO2 = 0;
      float scdTemp = 0.0f;
      float scdHum  = 0.0f;

      if (scd40ReadMeasurement(scdCO2, scdTemp, scdHum)) {
        logPrintf("[SCD40] True CO2: %u ppm | Temp: %.1f C | Humidity: %.1f %%\n",
                  scdCO2, scdTemp, scdHum);
        // Nếu DHT22 chưa cắm/lỗi thì lấy nhiệt độ & độ ẩm của SCD40 để bù cho MQ135
        if (isnan(refTemp) || isnan(refHum)) {
          refTemp = scdTemp;
          refHum  = scdHum;
        }
      } else {
        logPrintf("[SCD40] Loi doc du lieu I2C / CRC!\n");
      }
    } else {
      logPrintf("[SCD40] Dang chuan bi du lieu do...\n");
    }
  } else {
    logPrintf("[SCD40] Chua ket noi (VCC->3V3, GND->GND, SDA->GPIO8, SCL->GPIO9)\n");
  }

  // 3. Đọc & hiển thị MQ135 (Analog Raw + CO2 ước lượng)
  int mq135Raw = analogRead(MQ135_PIN);
  float mq135Voltage = mq135Raw * (3.3f / 4095.0f);
  float mq135CO2 = calculateMQ135CO2PPM(mq135Raw, refTemp, refHum);

  if (mq135Raw == 0) {
    logPrintf("[MQ135] Raw: 0 (0.00 V) -> Kiem tra VCC (3V3/5V) va chan AO -> GPIO %d\n", MQ135_PIN);
  } else {
    logPrintf("[MQ135] Est. CO2: %.1f ppm | Raw: %d (%.2f V)\n",
              mq135CO2, mq135Raw, mq135Voltage);
  }

  logPrintf("Status: OK\n");
}